# ==================== 微信支付 V3 配置 ====================
WECHAT_APP_ID=your_app_id
WECHAT_MCH_ID=your_mch_id
WECHAT_API_V3_KEY=your_32_char_api_v3_key
WECHAT_P12_PATH=/path/to/apiclient_cert.p12
WECHAT_P12_PASSWORD=
WECHAT_NOTIFY_URL=https://your-domain.com/wechat/notify
# JSAPI支付需要真实openid
WECHAT_OPENID=your_test_openid

# ==================== 支付宝配置 ====================
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_APP_PRIVATE_KEY=your_rsa_private_key_base64
ALIPAY_PUBLIC_KEY=your_alipay_public_key_base64
ALIPAY_ROOT_CERT_PATH=/path/to/alipay_root_cert.txt
ALIPAY_SIGN_TYPE=RSA2
